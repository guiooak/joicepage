{
  "hosting": {
    "public": "_site",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],

    "redirects": [
      {
        "source": "/mobile",
        "destination": "/",
        "type": 301
      },
      {
        "source": "/mobile/**",
        "destination": "/",
        "type": 301
      },
      {
        "source": "/inicio",
        "destination": "/",
        "type": 301
      },
      {
        "source": "/inicio/**",
        "destination": "/",
        "type": 301
      },
      {
        "source": "/js",
        "destination": "/",
        "type": 301
      },
      {
        "source": "/js/**",
        "destination": "/",
        "type": 301
      },
      {
        "source": "/br",
        "destination": "/",
        "type": 301
      },
      {
        "source": "/br/**",
        "destination": "/",
        "type": 301
      }
    ],

    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "Referrer-Policy",
            "value": "strict-origin-when-cross-origin"
          },
          {
            "key": "X-Frame-Options",
            "value": "DENY"
          },
          {
            "key": "Content-Security-Policy",
            "value": "frame-ancestors 'none'"
          },
          {
            "key": "Permissions-Policy",
            "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=(), serial=(), bluetooth=(), hid=(), midi=(), browsing-topics=()"
          }
        ]
      },
      {
        "regex": "^(.*/|.*\\.(html|js|css))$",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "**/*.@(woff2|jpg|png|svg|webp)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=604800"
          }
        ]
      }
    ]
  }
}
