{
  "hosting": {
    "public": "_site",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],

    "redirects": [
      {
        "source": "/mobile",
        "destination": "/",
        "type": 301
      },
      {
        "source": "/mobile/**",
        "destination": "/",
        "type": 301
      },
      {
        "source": "/inicio",
        "destination": "/",
        "type": 301
      },
      {
        "source": "/inicio/**",
        "destination": "/",
        "type": 301
      },
      {
        "source": "/js",
        "destination": "/",
        "type": 301
      },
      {
        "source": "/js/**",
        "destination": "/",
        "type": 301
      },
      {
        "source": "/br",
        "destination": "/",
        "type": 301
      },
      {
        "source": "/br/**",
        "destination": "/",
        "type": 301
      }
    ],

    "headers": [
      {
        "regex": "^(.*/|.*\\.(html|js|css))$",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "**/*.@(woff2|jpg|png|svg|webp)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=604800"
          }
        ]
      }
    ]
  }
}
